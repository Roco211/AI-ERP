APP_ENV=development
DATABASE_URL=postgresql+psycopg://forge_app:APP_DATABASE_PASSWORD@127.0.0.1:55438/forge
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:MIGRATION_DATABASE_PASSWORD@127.0.0.1:55438/forge
POSTGRES_PASSWORD=MIGRATION_DATABASE_PASSWORD
FORGE_APP_PASSWORD=APP_DATABASE_PASSWORD
REDIS_URL=redis://127.0.0.1:56379/0
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3100
API_INTERNAL_URL=http://127.0.0.1:8100
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=SET_A_LOCAL_PASSWORD_AT_LEAST_12_CHARACTERS

# Optional, local-only semantic search. Enable after pulling and pinning the model.
EMBEDDING_ENABLED=false
